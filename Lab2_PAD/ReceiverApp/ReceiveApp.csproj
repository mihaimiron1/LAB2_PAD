<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\EnvironmentSettings.cs" Link="Configuration\EnvironmentSettings.cs" />
    <Compile Include="..\BrokerChannelFactory.cs" Link="Configuration\BrokerChannelFactory.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- contractul comun; receiverul genereaza doar partea de client -->
    <Protobuf Include="..\Protos\messagehub.proto" GrpcServices="Client" ProtoRoot="..\Protos" Link="Protos\messagehub.proto" />
  </ItemGroup>

</Project>
