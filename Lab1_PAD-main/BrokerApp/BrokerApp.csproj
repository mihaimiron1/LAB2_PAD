<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.84.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- serverul gRPC (Kestrel, HTTP/2) ruleaza in acelasi proces cu interfata Avalonia -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\EnvironmentSettings.cs" Link="Configuration\EnvironmentSettings.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- contractul comun; brokerul genereaza doar partea de server -->
    <Protobuf Include="..\Protos\messagehub.proto" GrpcServices="Server" ProtoRoot="..\Protos" Link="Protos\messagehub.proto" />
  </ItemGroup>

</Project>
